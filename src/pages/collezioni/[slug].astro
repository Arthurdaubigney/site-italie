---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Img from '../../components/Img.astro';
import Cta from '../../components/Cta.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { CATEGORIES } from '../../data/site';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const others = CATEGORIES.filter((o) => o.slug !== c.slug).slice(0, 3);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={c.title} description={c.description} ogImage={c.image} crumbs={[{ name: 'Collezioni', href: '/collezioni' }, { name: c.name, href: `/collezioni/${c.slug}` }]} jsonLd={[faqLd]}>
  <PageHero h1={c.h1} lead={c.lead} eyebrow="Collezioni" crumbs={[{ name: 'Collezioni', href: '/collezioni' }, { name: c.name }]} />

  <section class="section">
    <div class="wrap split">
      <div class="split-media reveal"><div class="frame"><Img name={c.image} eager sizes="(min-width: 860px) 50vw, 100vw" alt={c.alt} title={c.name} /></div></div>
      <div class="reveal">
        <h2>Cosa valutiamo</h2>
        <ul class="ticks">{c.items.map((i) => <li>{i}</li>)}</ul>
        {c.body.map((p) => <p style="margin-top:1.4em;color:var(--muted)">{p}</p>)}
        <div class="actions"><Cta variant="default" /></div>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <div class="section-head center reveal"><span class="eyebrow">Domande frequenti</span><h2>{c.name}: le risposte</h2></div>
      <div class="reveal"><Faq items={c.faq} /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal"><span class="eyebrow">Altre collezioni</span><h2>Continua a esplorare</h2></div>
      <div class="cards">
        {others.map((o) => (
          <a class="card reveal" href={`/collezioni/${o.slug}`}>
            <div class="frame"><Img name={o.image} alt={o.alt} title={o.name} /></div>
            <h3>{o.name}</h3><p>{o.short}</p><span class="link">Scopri</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
