---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base
  title="La Galleria | Antiquariato e Opere d’Arte a Milano"
  description="Galleria Antica S.r.l.: antiquariato e opere d’arte a Milano. Scopri il nostro approccio fatto di selezione, competenza, discrezione e cura di ogni pezzo."
  ogImage="visitor"
  crumbs={[{ name: 'La Galleria', href: '/la-galleria/' }]}
>
  <PageHero
    h1="La Galleria Antica di Milano: antiquariato e opere d’arte"
    lead="Una galleria milanese dedicata all’arte e all’antiquariato di qualità: acquisto, stima e vendita, con uno stile sobrio e discreto."
    eyebrow="La Galleria"
    crumbs={[{ name: 'La Galleria' }]}
  />

  <section class="section">
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">Il nostro approccio</span>
        <h2>Selezione, competenza, discrezione</h2>
        <p class="lead">Ogni opera ha una storia e un valore. Il nostro lavoro è riconoscerli, spiegarli e proteggerli.</p>
        <p style="color:var(--muted)">La Galleria Antica nasce a Milano per mettere in contatto chi possiede opere d’arte e oggetti di pregio con chi li cerca e li sa apprezzare. Lavoriamo con privati, famiglie, studi professionali e collezionisti, con un unico criterio: la qualità.</p>
        <p style="color:var(--muted)">Ci occupiamo di ogni fase, dalla prima fotografia al ritiro a domicilio, in tutta Italia.</p>
      </div>
      <div class="split-media reveal"><div class="frame"><Img name="visitor" sizes="(min-width: 860px) 50vw, 100vw" alt="Visitatrice seduta davanti a fotografie incorniciate in una galleria d’arte" title="Una visitatrice in galleria d’arte" /></div></div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <div class="section-head reveal"><span class="eyebrow">I nostri valori</span><h2>Come lavoriamo</h2></div>
      <ol class="services reveal" style="grid-template-columns:repeat(3,1fr)">
        <li class="service"><span class="num">01</span><h3>Competenza</h3><p>Osserviamo materiali, tecniche, firme e stato di conservazione di ogni pezzo.</p></li>
        <li class="service"><span class="num">02</span><h3>Trasparenza</h3><p>Spieghiamo con chiarezza come nasce una valutazione e quali sono i passaggi.</p></li>
        <li class="service"><span class="num">03</span><h3>Riservatezza</h3><p>Trattiamo con discrezione persone, collezioni e patrimoni di famiglia.</p></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--flip">
      <div class="split-media split-media--wide reveal"><div class="frame"><Img name="gallery-wall" sizes="(min-width: 860px) 50vw, 100vw" alt="Dipinti antichi in cornice esposti su parete rossa in una galleria" title="Dipinti antichi esposti in galleria" /></div></div>
      <div class="reveal">
        <span class="eyebrow">Milano</span>
        <h2>Nel cuore dell’arte e del design</h2>
        <p style="color:var(--muted)">Milano è la città del gusto, delle gallerie e dei grandi interior designer. La Galleria Antica ne interpreta lo spirito: un antiquariato sobrio, contemporaneo nell’approccio e rigoroso nella scelta.</p>
      </div>
    </div>
  </section>
  <CtaBand title="Parliamo delle tue opere" />
</Base>
