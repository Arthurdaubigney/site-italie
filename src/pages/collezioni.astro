---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
import { CATEGORIES } from '../data/site';
---
<Base
  title="Collezioni di Antiquariato e Opere d’Arte | Milano"
  description="Le collezioni della Galleria Antica di Milano: dipinti antichi, mobili, argenti e bronzi, orologi, tappeti e sculture. Stima e acquisto con ritiro a domicilio."
  crumbs={[{ name: 'Collezioni', href: '/collezioni/' }]}
  ogImage="vitrines"
>
  <PageHero
    h1="Collezioni di antiquariato e opere d’arte a Milano"
    lead="Dipinti, mobili, argenti, bronzi, orologi, tappeti e sculture: le famiglie di oggetti che la Galleria acquista, valuta e propone."
    crumbs={[{ name: 'Collezioni' }]}
    eyebrow="Le collezioni"
  />
  <section class="section">
    <div class="wrap cards">
      {CATEGORIES.map((c, i) => (
        <a class="card reveal" style={`--d:${(i % 3) * 0.08}s`} href={`/collezioni/${c.slug}/`}>
          <div class="frame"><Img name={c.image} alt={c.alt} title={c.name} /></div>
          <h2 style="font-size:1.75rem;margin-bottom:8px">{c.name}</h2>
          <p>{c.short}</p>
          <span class="link">Scopri la categoria</span>
        </a>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
