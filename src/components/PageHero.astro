---
interface Props { h1: string; lead?: string; crumbs?: { name: string; href?: string }[]; eyebrow?: string; }
const { h1, lead, crumbs = [], eyebrow } = Astro.props;
---
<header class="page-hero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href="/">Home</a></li>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
        </ol>
      </nav>
    )}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</header>
