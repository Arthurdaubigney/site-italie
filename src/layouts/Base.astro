---
import '../styles/global.css';
import { SITE, NAV, CATEGORIES } from '../data/site';
import logo from '../data/logo.json';
import Cta from '../components/Cta.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  crumbs?: { name: string; href: string }[];
  jsonLd?: Record<string, unknown>[];
}
const { title, description, ogImage = 'gallery-wall', noindex = false, crumbs = [], jsonLd = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '';
const canonical = `${SITE.url}${path}`;
const og = `${SITE.url}/img/${ogImage}-1400.webp`;

const business = {
  '@context': 'https://schema.org',
  '@type': ['ArtGallery', 'LocalBusiness'],
  '@id': `${SITE.url}/#galleria`,
  name: SITE.legalName,
  alternateName: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/img/logo.webp`,
  image: og,
  description: 'Galleria d’arte e antiquariato a Milano: acquisto, stima, perizia e vendita di dipinti, mobili antichi, argenti, bronzi e oggetti da collezione.',
  email: SITE.email,
  ...(SITE.phone ? { telephone: SITE.phone } : {}),
  address: { '@type': 'PostalAddress', addressLocality: 'Milano', addressRegion: 'MI', addressCountry: 'IT' },
  areaServed: ['Milano', 'Lombardia', 'Piemonte', 'Veneto', 'Emilia-Romagna'].map((n) => ({ '@type': 'AdministrativeArea', name: n })),
  priceRange: '€€€',
  knowsAbout: ['Antiquariato', 'Dipinti antichi', 'Mobili antichi', 'Argenti', 'Bronzi', 'Stima opere d’arte'],
};
const breadcrumbLd = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${SITE.url}${c.href === '/' ? '' : c.href}` })),
    }
  : null;
const graph = [business, ...(breadcrumbLd ? [breadcrumbLd] : []), ...jsonLd];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#f6f2ea" />
    <meta name="geo.region" content="IT-MI" />
    <meta name="geo.placename" content="Milano" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>
    <div class="topbar">
      <div class="wrap">
        <p class="topbar-note">Stima e spostamento gratuiti · Milano, Lombardia e Nord Italia</p>
        <div class="topbar-links">
          <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg><span>{SITE.phone}</span></a>
          <a class="topbar-mail" href={`mailto:${SITE.email}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/></svg><span>{SITE.email}</span></a>
        </div>
      </div>
    </div>
    <header class="site-header" id="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Galleria Antica Milano – Home">
          <img src="/img/mark.webp" width={logo.mark[0]} height={logo.mark[1]} alt="Monogramma GA della Galleria Antica" title="Galleria Antica" />
          <span class="brand-text">Galleria Antica<span>Milano</span></span>
        </a>
        <button class="burger" aria-label="Apri il menu" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
        <nav class="nav" id="nav" aria-label="Navigazione principale">
          {NAV.map((n) => <a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>{n.label}</a>)}
          <span class="nav-cta"><Cta small label="Stima gratuita" /></span>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <img src="/img/logo-light.webp" width={logo['logo-light'][0]} height={logo['logo-light'][1]} alt="Logo Galleria Antica S.r.l. Milano" title="Galleria Antica S.r.l. – Milano" loading="lazy" />
            <p>Antiquariato, perizie e opere d’arte a Milano. Acquisto, stima e vendita con ritiro a domicilio in Lombardia e Nord Italia.</p>
          </div>
          <nav aria-label="Collezioni">
            <h2>Collezioni</h2>
            <ul>{CATEGORIES.map((c) => <li><a href={`/collezioni/${c.slug}`}>{c.name}</a></li>)}</ul>
          </nav>
          <nav aria-label="Galleria">
            <h2>Galleria</h2>
            <ul>
              {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
              <li><a href="/contatti#stima">Richiedi una stima</a></li>
            </ul>
          </nav>
          <div>
            <h2>Contatti</h2>
            <ul>
              <li>{SITE.address}</li>
              <li>{SITE.hours}</li>
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              {SITE.phone && <li><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>}
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} {SITE.legalName} · Milano</span>
          <span><a href="/privacy">Privacy &amp; Cookie</a> · Fotografie: Unsplash (licenza libera)</span>
        </div>
      </div>
    </footer>

    <div class="mobile-cta"><a class="btn btn--gold" href={`tel:${SITE.phone.replace(/\s/g, '')}`}>Chiama ora</a><Cta label="Stima gratuita" /></div>

    <script is:inline>
      (function () {
        var h = document.querySelector('.site-header');
        var onScroll = function () { h.classList.toggle('is-scrolled', window.scrollY > 8); };
        onScroll(); addEventListener('scroll', onScroll, { passive: true });
        var b = document.querySelector('.burger'), n = document.getElementById('nav');
        b.addEventListener('click', function () {
          var o = b.getAttribute('aria-expanded') !== 'true';
          b.setAttribute('aria-expanded', o); n.classList.toggle('is-open', o);
          b.setAttribute('aria-label', o ? 'Chiudi il menu' : 'Apri il menu');
        });
        n.addEventListener('click', function (e) { if (e.target.closest('a')) { n.classList.remove('is-open'); b.setAttribute('aria-expanded', 'false'); } });
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('is-in'); }); return; }
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
  </body>
</html>
